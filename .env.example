# Database
DATABASE_URL="postgresql://user:password@host:5432/muse_connector?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:43123"

# Stripe (for contractor payments)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Contractor CRM Integrations
JOBBER_API_KEY="your-jobber-api-key"
JOBBER_API_URL="https://api.getjobber.com/api/graphql"

HOUSECALL_PRO_API_KEY="your-housecall-pro-api-key"
HOUSECALL_PRO_API_URL="https://api.housecallpro.com/v1"

# Email (Resend)
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@yourdomain.com"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:43123"
NODE_ENV="development"

# Sandbox Mode (set to "false" in production)
SANDBOX_MODE="true"

# Rate Limiting (requests per minute)
RATE_LIMIT_RPM="60"

# Monitoring (optional)
SENTRY_DSN=""
AXIOM_TOKEN=""
AXIOM_DATASET="muse-connector"
